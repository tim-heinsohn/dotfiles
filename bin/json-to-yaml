#!/bin/bash
#
# json-to-yaml: Convert JSON input to YAML
#
# Usage: json-to-yaml <input.json|-> [output.yaml]
#
# Description:
# Converts JSON documents to YAML using Python standard library only.
# Reads from a file or stdin ("-") and writes to stdout or an output file.
#
# Dependencies:
# - python3

set -euo pipefail

if [[ $# -lt 1 || $# -gt 2 ]]; then
    echo "Usage: $(basename "$0") <input.json|-> [output.yaml]" >&2
    exit 1
fi

input_path="$1"
output_path="${2:-}"

if [[ "$input_path" != "-" && ! -f "$input_path" ]]; then
    echo "Input file not found: $input_path" >&2
    exit 1
fi

python3 - "$input_path" "$output_path" <<'PY'
import json
import math
import pathlib
import re
import sys

KEY_PATTERN = re.compile(r"^[A-Za-z_][A-Za-z0-9_-]*$")


def format_key(key: str) -> str:
    if KEY_PATTERN.match(key):
        return key
    return json.dumps(key, ensure_ascii=False)


def format_scalar(value) -> str:
    if isinstance(value, str):
        return json.dumps(value, ensure_ascii=False)
    if value is True:
        return "true"
    if value is False:
        return "false"
    if value is None:
        return "null"
    if isinstance(value, int):
        return str(value)
    if isinstance(value, float):
        if math.isnan(value) or math.isinf(value):
            raise ValueError("JSON contains unsupported number value (NaN/Infinity)")
        return repr(value)
    raise TypeError(f"Unsupported value type: {type(value).__name__}")


def dump_yaml(value, indent: int = 0) -> str:
    prefix = " " * indent

    if isinstance(value, dict):
        if not value:
            return "{}"
        lines = []
        for key, item in value.items():
            rendered_key = format_key(str(key))
            if isinstance(item, (dict, list)):
                lines.append(f"{prefix}{rendered_key}:")
                lines.append(dump_yaml(item, indent + 2))
            else:
                lines.append(f"{prefix}{rendered_key}: {format_scalar(item)}")
        return "\n".join(lines)

    if isinstance(value, list):
        if not value:
            return "[]"
        lines = []
        for item in value:
            if isinstance(item, (dict, list)):
                lines.append(f"{prefix}-")
                lines.append(dump_yaml(item, indent + 2))
            else:
                lines.append(f"{prefix}- {format_scalar(item)}")
        return "\n".join(lines)

    return f"{prefix}{format_scalar(value)}"


def main() -> int:
    input_arg = sys.argv[1]
    output_arg = sys.argv[2]

    try:
        if input_arg == "-":
            raw = sys.stdin.read()
        else:
            raw = pathlib.Path(input_arg).read_text(encoding="utf-8")

        parsed = json.loads(raw)
        rendered = dump_yaml(parsed)
    except json.JSONDecodeError as exc:
        sys.stderr.write(f"Invalid JSON: {exc}\n")
        return 1
    except (OSError, TypeError, ValueError) as exc:
        sys.stderr.write(f"Conversion failed: {exc}\n")
        return 1

    if not rendered.endswith("\n"):
        rendered += "\n"

    if output_arg:
        pathlib.Path(output_arg).write_text(rendered, encoding="utf-8")
    else:
        sys.stdout.write(rendered)

    return 0


raise SystemExit(main())
PY
