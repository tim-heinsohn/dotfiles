#!/bin/bash

# scan: Epson V330 batch scanning
#
# Usage: scan [options]
# Interactive mode: keyboard controls
# Button mode (--button): Start key on scanner triggers each page scan

set -euo pipefail

FAKE_MODE="${SCAN_V330_FAKE:-}"
SKIP_DETECT="${SCAN_V330_SKIP_DETECT:-}"

# Default settings
RESOLUTION=150
MODE="Gray"
FORMAT="png"
OUTPUT_DIR="$HOME/Scans/batch_$(date +%Y%m%d_%H%M%S)"
PREFIX="scan"
PREFIX_SET=false
START_COUNT=1
START_COUNT_SET=false
CREATE_PDF=true
BUTTON_MODE=false
MAX_PAGES=0        # 0 = unlimited (button mode only)
DEVICE=""
KEEP_IMAGES=false  # keep individual image files after PDF creation
APPEND_TO=""
PDF_FILE=""
ACTIVE_SCAN_FILE=""

# Colors
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
BLUE='\033[0;34m'
NC='\033[0m'

usage() {
    cat << EOF
Epson V330 Batch Scanner

Usage: $(basename "$0") [OPTIONS]

OPTIONS:
    -r, --resolution DPI    Scan resolution (default: 150)
    -m, --mode MODE         Scan mode: Color, Gray, Binary/LineArt (default: Gray)
    -f, --format FORMAT     Output format: png, tiff, jpeg (default: png)
    -b, --batch             Enable batch mode (the default)
    -d, --directory DIR     Output directory (default: ~/Scans/batch_TIMESTAMP)
    -p, --prefix PREFIX     Filename prefix (default: scan)
    -a, --append-to FILE    Append pages to an existing PDF. The prefix must
                            match the PDF filename when explicitly provided.
    -s, --start NUM         Starting number (default: 1, or next page when appending)
    --no-pdf                Skip combined PDF generation
    --keep                  Keep individual image files after PDF creation
    --button                Non-interactive mode: press scanner Start key to
                            trigger each page scan; Ctrl+C to finish
    --count NUM             Stop after NUM pages (button mode only; default: unlimited)
    --device DEV            Scanner device string (auto-detected if omitted)
    -h, --help              Show this help

INTERACTIVE CONTROLS (default mode):
    Enter    - Scan current page
    n        - Next page (increment counter)
    p        - Previous page (decrement counter)
    r        - Rescan current page
    q        - Quit and generate combined PDF
    s        - Skip to specific number

EOF
}

log_info() {
    echo -e "${GREEN}[BATCH]${NC} $1"
}

log_prompt() {
    echo -e "${BLUE}[INPUT]${NC} $1"
}

log_warn() {
    echo -e "${YELLOW}[WARN]${NC} $1"
}

log_error() {
    echo -e "${RED}[ERROR]${NC} $1"
}

normalize_mode() {
    local normalized_mode
    normalized_mode=$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]')

    case "$normalized_mode" in
        color)
            echo "Color"
            ;;
        gray|grey|grayscale|greyscale)
            echo "Gray"
            ;;
        binary|lineart|line-art)
            echo "Binary"
            ;;
        *)
            return 1
            ;;
    esac
}

resolve_scan_resolution() {
    case "$1" in
        150)
            # The V330 backend only exposes 100/200/300/... DPI.
            echo "300"
            ;;
        *)
            echo "$1"
            ;;
    esac
}

resample_scan_output() {
    local input_file="$1"
    local output_format="$2"
    local resized_file
    resized_file=$(mktemp "${input_file}.XXXXXX")

    if command -v magick >/dev/null 2>&1; then
        if ! magick "$input_file" -resize 50% -units PixelsPerInch -density "$RESOLUTION" \
            "${output_format}:$resized_file"; then
            rm -f -- "$resized_file"
            log_error "Failed to scale scan output to $RESOLUTION DPI"
            return 1
        fi
    elif command -v convert >/dev/null 2>&1; then
        if ! convert "$input_file" -resize 50% -units PixelsPerInch -density "$RESOLUTION" \
            "${output_format}:$resized_file"; then
            rm -f -- "$resized_file"
            log_error "Failed to scale scan output to $RESOLUTION DPI"
            return 1
        fi
    else
        rm -f "$resized_file"
        log_error "150 DPI output requires ImageMagick (magick or convert)"
        return 1
    fi

    mv "$resized_file" "$input_file"
}

detect_scanner() {
    if [[ -n "$SKIP_DETECT" || -n "$FAKE_MODE" ]]; then
        DEVICE="${DEVICE:-FAKE_DEVICE}"
        log_warn "Skipping scanner detection (debug mode)"
        return
    fi

    local scanner_info
    scanner_info=$(scanimage -L 2>/dev/null | grep "Epson Perfection V330" || true)

    if [[ -z "$scanner_info" ]]; then
        log_error "Epson Perfection V330 scanner not found"
        log_error "Please connect the scanner via USB and make sure it is powered on."
        if command -v lsusb >/dev/null 2>&1 && ! lsusb 2>/dev/null | grep -qi epson; then
            log_error "No Epson device found on USB (lsusb shows no Epson entry)."
        fi
        return 1
    fi

    DEVICE="${scanner_info#*\`}"
    DEVICE=$(printf '%s' "$DEVICE" | cut -d"'" -f1)
    log_info "Found scanner: $scanner_info"
}

scan_page() {
    local filepath="$1"
    local wait_for_button="${2:-false}"
    local scan_resolution
    local staged_file="${filepath}.part"
    scan_resolution=$(resolve_scan_resolution "$RESOLUTION")
    rm -f -- "$staged_file"
    ACTIVE_SCAN_FILE="$staged_file"

    if [[ -n "$FAKE_MODE" ]]; then
        log_warn "Generating fake scan output (debug mode)"
        if command -v magick >/dev/null 2>&1; then
            if ! magick -size 600x600 xc:white "${FORMAT}:$staged_file"; then
                rm -f -- "$staged_file"
                ACTIVE_SCAN_FILE=""
                return 1
            fi
        elif command -v convert >/dev/null 2>&1; then
            if ! convert -size 600x600 xc:white "${FORMAT}:$staged_file"; then
                rm -f -- "$staged_file"
                ACTIVE_SCAN_FILE=""
                return 1
            fi
        else
            rm -f -- "$staged_file"
            ACTIVE_SCAN_FILE=""
            log_error "Fake scan output requires ImageMagick"
            return 1
        fi
    else
        local cmd=(scanimage -d "$DEVICE" --resolution "$scan_resolution" --mode "$MODE" "--format=$FORMAT")
        [[ "$wait_for_button" == "true" ]] && cmd+=(--wait-for-button=yes)
        if ! "${cmd[@]}" > "$staged_file"; then
            rm -f -- "$staged_file"
            ACTIVE_SCAN_FILE=""
            return 1
        fi
    fi

    if [[ ! -s "$staged_file" ]]; then
        rm -f -- "$staged_file"
        ACTIVE_SCAN_FILE=""
        log_error "Scan produced no data"
        return 1
    fi

    if [[ -z "$FAKE_MODE" && "$RESOLUTION" == "150" && "$scan_resolution" != "$RESOLUTION" ]]; then
        log_info "Scanner backend does not support 150 DPI directly; scaling output down to 150 DPI"
        if ! resample_scan_output "$staged_file" "$FORMAT"; then
            rm -f -- "$staged_file"
            ACTIVE_SCAN_FILE=""
            return 1
        fi
    fi

    mv -- "$staged_file" "$filepath"
    ACTIVE_SCAN_FILE=""
}

create_combined_pdf() {
    if [[ "$CREATE_PDF" != "true" ]]; then
        return 1
    fi

    local image_files=()

    # Collect all scanned images in order
    while IFS= read -r -d '' file; do
        image_files+=("$file")
    done < <(find "$OUTPUT_DIR" -maxdepth 1 -type f -size +0c \( -name "*.png" -o -name "*.tiff" -o -name "*.jpeg" -o -name "*.jpg" \) -print0 | sort -z)

    if [[ ${#image_files[@]} -eq 0 ]]; then
        log_warn "No images found to combine into PDF"
        return 1
    fi

    log_info "Creating combined PDF with ${#image_files[@]} pages..."

    if command -v img2pdf &> /dev/null; then
        if img2pdf --output "$PDF_FILE" "${image_files[@]}"; then
            log_info "Created: $PDF_FILE"
            return 0
        else
            log_error "Failed to create PDF with img2pdf"
            return 1
        fi
    elif command -v convert &> /dev/null; then
        if convert "${image_files[@]}" "$PDF_FILE"; then
            log_info "Created: $PDF_FILE"
            return 0
        else
            log_error "Failed to create PDF with ImageMagick"
            return 1
        fi
    else
        log_error "Neither img2pdf nor ImageMagick available for PDF creation"
        log_info "Install with: yay -S img2pdf"
        return 1
    fi
}

cleanup_temp_images() {
    if [[ "$KEEP_IMAGES" == "true" ]]; then
        return
    fi

    if [[ "$CREATE_PDF" != "true" ]]; then
        return
    fi

    if [[ ! -f "$PDF_FILE" ]]; then
        return
    fi

    log_info "Removing temporary image files..."
    local removed=0
    while IFS= read -r -d '' file; do
        rm -f "$file"
        removed=$((removed + 1))
    done < <(find "$OUTPUT_DIR" -maxdepth 1 -type f \( -name "*.png" -o -name "*.tiff" -o -name "*.jpeg" -o -name "*.jpg" \) -print0)
    log_info "Removed $removed temporary image file(s)"
}

append_to_pdf() {
    local append_directory
    append_directory=$(dirname "$APPEND_TO")
    local append_basename
    append_basename=$(basename "$APPEND_TO")
    local temporary_file
    temporary_file=$(mktemp "$append_directory/.${append_basename}.XXXXXX.pdf")

    # Build beside the destination so the final move is atomic.
    if ! pdfunite "$APPEND_TO" "$PDF_FILE" "$temporary_file"; then
        rm -f "$temporary_file"
        log_error "Failed to append scanned pages to: $APPEND_TO"
        return 1
    fi

    mv "$temporary_file" "$APPEND_TO"
    log_info "Appended scanned pages to: $APPEND_TO"
}

finish_batch() {
    local current_count="$1"
    local successful_scans="$2"

    if ! create_combined_pdf; then
        return 1
    fi

    if [[ -n "$APPEND_TO" ]]; then
        append_to_pdf || return 1
    fi

    cleanup_temp_images
    [[ -n "$APPEND_TO" ]] && rm -f "$PDF_FILE"
    print_summary "$current_count" "$successful_scans"
}

# Parse arguments
while [[ $# -gt 0 ]]; do
    case $1 in
        -r|--resolution)
            RESOLUTION="$2"
            shift 2
            ;;
        -m|--mode)
            MODE="$2"
            shift 2
            ;;
        -f|--format)
            FORMAT="$2"
            shift 2
            ;;
        -b|--batch)
            shift
            ;;
        -d|--directory)
            OUTPUT_DIR="$2"
            shift 2
            ;;
        -p|--prefix)
            PREFIX="$2"
            PREFIX_SET=true
            shift 2
            ;;
        -a|--append-to)
            if [[ $# -lt 2 ]]; then
                log_error "$1 requires a PDF path"
                exit 1
            fi
            APPEND_TO="$2"
            shift 2
            ;;
        -s|--start)
            START_COUNT="$2"
            START_COUNT_SET=true
            shift 2
            ;;
        --no-pdf)
            CREATE_PDF=false
            shift
            ;;
        --keep)
            KEEP_IMAGES=true
            shift
            ;;
        --button)
            BUTTON_MODE=true
            shift
            ;;
        --count)
            MAX_PAGES="$2"
            shift 2
            ;;
        --device)
            DEVICE="$2"
            shift 2
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        *)
            log_error "Unknown option: $1"
            usage
            exit 1
            ;;
    esac
done

if ! MODE=$(normalize_mode "$MODE"); then
    log_error "Invalid mode: $MODE"
    usage
    exit 1
fi

case "$RESOLUTION" in
    75|150|200|300|600|1200|2400|4800) ;;
    *) log_error "Invalid resolution: $RESOLUTION"; exit 1 ;;
esac

case "$FORMAT" in
    png|tiff|jpeg) ;;
    *) log_error "Invalid format: $FORMAT (use png, tiff, or jpeg)"; exit 1 ;;
esac

if ! [[ "$START_COUNT" =~ ^[1-9][0-9]*$ ]]; then
    log_error "Starting page number must be a positive integer: $START_COUNT"
    exit 1
fi

if ! [[ "$MAX_PAGES" =~ ^[0-9]+$ ]]; then
    log_error "Page count must be a non-negative integer: $MAX_PAGES"
    exit 1
fi

if [[ -n "$APPEND_TO" ]]; then
    if [[ "$CREATE_PDF" != "true" ]]; then
        log_error "--append-to cannot be used with --no-pdf"
        exit 1
    fi
    if [[ ! -f "$APPEND_TO" ]] || ! file --brief --mime-type -- "$APPEND_TO" | grep -qx 'application/pdf'; then
        log_error "--append-to must reference an existing PDF: $APPEND_TO"
        exit 1
    fi
    if ! command -v pdfunite >/dev/null 2>&1; then
        log_error "Appending PDFs requires pdfunite (install poppler)"
        exit 1
    fi
    if ! command -v pdfinfo >/dev/null 2>&1; then
        log_error "Determining the next page number requires pdfinfo (install poppler)"
        exit 1
    fi

    pdf_metadata=""
    if ! pdf_metadata=$(pdfinfo "$APPEND_TO" 2>/dev/null); then
        log_error "Could not read page count from PDF: $APPEND_TO"
        exit 1
    fi
    existing_page_count=""
    while IFS=: read -r metadata_key metadata_value; do
        if [[ "$metadata_key" == "Pages" ]]; then
            existing_page_count="${metadata_value//[[:space:]]/}"
            break
        fi
    done <<< "$pdf_metadata"
    if ! [[ "$existing_page_count" =~ ^[0-9]+$ ]]; then
        log_error "Could not read page count from PDF: $APPEND_TO"
        exit 1
    fi
    if [[ "$START_COUNT_SET" != "true" ]]; then
        START_COUNT=$((existing_page_count + 1))
    fi

    append_prefix=$(basename "$APPEND_TO")
    append_prefix="${append_prefix%.*}"
    if [[ "$PREFIX_SET" == "true" && "$PREFIX" != "$append_prefix" ]]; then
        log_error "Prefix '$PREFIX' does not match append target '$append_prefix.pdf'"
        exit 1
    fi
    PREFIX="$append_prefix"
fi

# ---------------------------------------------------------------------------
# Button mode (non-interactive)
# ---------------------------------------------------------------------------
# Uses scanimage --wait-for-button=yes: the scan command itself blocks until
# the physical Start key is pressed, then immediately acquires the image.
# No polling loop required.
run_button_mode() {
    echo -e "${GREEN}Epson V330 Batch Scanner — Button Mode${NC}"
    echo "Output directory: $OUTPUT_DIR"
    echo "Settings: ${RESOLUTION} DPI, $MODE, $FORMAT"
    [[ "$MAX_PAGES" -gt 0 ]] && echo "Max pages: $MAX_PAGES"
    echo
    echo "Place each page on the scanner and press the Start key to scan it."
    echo "Press Ctrl+C to finish and generate the combined PDF."
    echo
    echo "Starting with page $START_COUNT..."

    local current_count=$START_COUNT
    local successful_scans=0

    # Ensure clean finish on Ctrl+C or terminal close
    trap 'echo; log_info "Interrupted — finishing up..."; \
          rm -f -- "${ACTIVE_SCAN_FILE:-}"; ACTIVE_SCAN_FILE=""; \
          finish_batch "$current_count" "$successful_scans"; \
          exit $?' INT TERM HUP

    while true; do
        # Stop after MAX_PAGES if set
        if [[ "$MAX_PAGES" -gt 0 ]] && \
           [[ $((current_count - START_COUNT)) -ge "$MAX_PAGES" ]]; then
            log_info "Reached page limit ($MAX_PAGES). Done."
            break
        fi

        local filename
        filename=$(printf "%s_%03d.%s" "$PREFIX" "$current_count" "$FORMAT")
        local filepath="$OUTPUT_DIR/$filename"

        log_info "Page $current_count — waiting for Start button press..."

        if scan_page "$filepath" true; then
            log_info "Saved: $filename"
            current_count=$((current_count + 1))
            successful_scans=$((successful_scans + 1))
        else
            log_error "✗ Scan failed for page $current_count"
        fi
    done

    finish_batch "$current_count" "$successful_scans"
}

# ---------------------------------------------------------------------------
# Interactive mode (original)
# ---------------------------------------------------------------------------
run_interactive_mode() {
    echo -e "${GREEN}Epson V330 Batch Scanner${NC}"
    echo "Output directory: $OUTPUT_DIR"
    echo "Settings: ${RESOLUTION} DPI, $MODE, $FORMAT"
    echo
    echo "Controls:"
    echo "  Enter - Scan page"
    echo "  n     - Next page"
    echo "  p     - Previous page"
    echo "  r     - Rescan page"
    echo "  s     - Skip to number"
    echo "  q     - Quit"
    echo
    echo "Starting with page $START_COUNT..."

    local current_count=$START_COUNT
    local successful_scans=0

    # Ensure clean finish on Ctrl+C or terminal close
    trap 'echo; log_info "Interrupted — finishing up..."; \
          rm -f -- "${ACTIVE_SCAN_FILE:-}"; ACTIVE_SCAN_FILE=""; \
          finish_batch "$current_count" "$successful_scans"; \
          exit $?' INT TERM HUP

    while true; do
        # Generate filename
        local filename
        filename=$(printf "%s_%03d.%s" "$PREFIX" "$current_count" "$FORMAT")
        local filepath="$OUTPUT_DIR/$filename"

        log_prompt "Page $current_count - Place document and press Enter to scan (or n/p/r/s/q): "

        # Read single character without requiring Enter
        local key
        if ! read -r -n 1 -s key; then
            echo
            log_info "Input closed; ending batch"
            break
        fi
        echo  # newline

        case "$key" in
            $'\n'|"")
                # Scan current page
                log_info "Scanning page $current_count..."
                if scan_page "$filepath"; then
                    log_info "Saved: $filename"
                    current_count=$((current_count + 1))
                    successful_scans=$((successful_scans + 1))
                else
                    log_error "✗ Scan failed for page $current_count"
                fi
                ;;
            n|N)
                current_count=$((current_count + 1))
                log_info "Advanced to page $current_count"
                ;;
            p|P)
                if [[ $current_count -gt 1 ]]; then
                    current_count=$((current_count - 1))
                    log_info "Went back to page $current_count"
                else
                    log_warn "Already at first page"
                fi
                ;;
            r|R)
                log_info "Rescanning page $current_count..."
                local was_scanned=false
                [[ -f "$filepath" ]] && was_scanned=true
                if scan_page "$filepath"; then
                    log_info "Rescanned: $filename"
                    if [[ "$was_scanned" == "false" ]]; then
                        successful_scans=$((successful_scans + 1))
                    fi
                else
                    log_error "✗ Rescan failed"
                fi
                ;;
            s|S)
                log_prompt "Enter page number: "
                local new_count
                if ! read -r new_count; then
                    echo
                    log_info "Input closed; ending batch"
                    break
                fi
                if [[ "$new_count" =~ ^[0-9]+$ ]] && [[ $new_count -gt 0 ]]; then
                    current_count=$new_count
                    log_info "Skipped to page $current_count"
                else
                    log_error "Invalid page number"
                fi
                ;;
            q|Q)
                finish_batch "$current_count" "$successful_scans"
                exit 0
                ;;
            *)
                log_warn "Unknown command: $key"
                ;;
        esac
    done

    finish_batch "$current_count" "$successful_scans"
}

print_summary() {
    local current_count=$1
    local successful_scans=$2
    log_info "Batch scanning completed. Files saved to: $OUTPUT_DIR"
    echo
    echo "Summary:"
    echo "  Attempted pages: $((current_count - START_COUNT))"
    echo "  Successful scans: $successful_scans"
    echo "  Files in: $OUTPUT_DIR"
    ls -la "$OUTPUT_DIR" 2>/dev/null || true
}

# ---------------------------------------------------------------------------
# Main
# ---------------------------------------------------------------------------

# Create output directory and the combined-PDF destination.
mkdir -p "$OUTPUT_DIR"
if [[ -n "$APPEND_TO" ]]; then
    PDF_FILE=$(mktemp "$OUTPUT_DIR/.${PREFIX}.XXXXXX.pdf")
else
    PDF_FILE="$OUTPUT_DIR/${PREFIX}.pdf"
fi

if [[ -z "$DEVICE" ]]; then
    detect_scanner
fi

if [[ "$BUTTON_MODE" == "true" ]]; then
    run_button_mode
else
    run_interactive_mode
fi

