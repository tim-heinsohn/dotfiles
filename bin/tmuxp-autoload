#!/bin/bash
#
# tmuxp-autoload: Start tmuxp sessions from dotfiles autoload configs
#
# Usage: tmuxp-autoload
#
# Description:
# Reads autoload session definitions from:
# - ~/dotfiles/tmuxp/autoload                  (cwd: ~/dotfiles/)
# - ~/*.dotfiles/tmuxp/autoload                (cwd: fleet root or parent)
# - ~/*/.../*.dotfiles/tmuxp/autoload           (cwd: fleet root)
#
# Discovery walks fleet roots (directories containing .fleet.yml) and finds
# *.dotfiles vessels with tmuxp/autoload inside them. This covers top-level
# dotfiles (~/ia.dotfiles) and fleet-nested ones (~/f/f.dotfiles).
#
# Dependencies:
# - i3-msg
# - wezterm

set -euo pipefail

tmux_session_script="$HOME/dotfiles/bin/tmux-session"

trim() {
  local value="$1"
  value="${value#"${value%%[![:space:]]*}"}"
  value="${value%"${value##*[![:space:]]}"}"
  printf '%s' "$value"
}

if [ ! -x "$tmux_session_script" ]; then
  echo "tmux-session script not executable: $tmux_session_script" >&2
  exit 1
fi

# Track processed autoload files to avoid duplicates (via symlinks or overlapping globs)
declare -A processed_files

process_autoload_file() {
  local autoload_file="$1"
  local cwd="$2"

  if [ ! -f "$autoload_file" ]; then
    return 0
  fi

  # Resolve to canonical path to prevent duplicate processing
  local canonical
  canonical="$(readlink -f "$autoload_file")"
  if [ -n "${processed_files[$canonical]+x}" ]; then
    return 0
  fi
  processed_files["$canonical"]=1

  while IFS= read -r raw_line || [ -n "$raw_line" ]; do
    line="${raw_line%%#*}"
    line="$(trim "$line")"

    if [ -z "$line" ]; then
      continue
    fi

    workspace="${line%%:*}"
    session="${line#*:}"
    workspace="$(trim "$workspace")"
    session="$(trim "$session")"

    if [ -z "$workspace" ] || [ -z "$session" ] || [ "$workspace" = "$line" ]; then
      echo "Skipping invalid autoload entry: $raw_line" >&2
      continue
    fi

    i3-msg "workspace number $workspace; exec --no-startup-id wezterm start --always-new-process --cwd '$cwd' -- '$tmux_session_script' '$session'" >/dev/null
    sleep 0.2
  done < "$autoload_file"
}

# Derive the fleet root (directory containing .fleet.yml) for a dotfiles path.
# Walks upward from the dotfiles dir. Returns the dotfiles parent if no manifest found.
find_fleet_root() {
  local dotfiles_dir="$1"
  local dir="${dotfiles_dir%/*}"

  while [ "$dir" != "$HOME" ] && [ "$dir" != "/" ]; do
    if [ -f "$dir/.fleet.yml" ]; then
      echo "$dir"
      return 0
    fi
    dir="${dir%/*}"
  done

  # Fallback: use the parent of the dotfiles directory
  echo "${dotfiles_dir%/*}"
}

# 1. Process the primary dotfiles first
process_autoload_file "$HOME/dotfiles/tmuxp/autoload" "$HOME/dotfiles"

# 2. Process top-level *.dotfiles (e.g., ~/ia.dotfiles)
shopt -s nullglob
for dotfiles_dir in "$HOME"/*.dotfiles; do
  autoload_file="$dotfiles_dir/tmuxp/autoload"
  if [ -f "$autoload_file" ]; then
    fleet_root="$(find_fleet_root "$dotfiles_dir")"
    process_autoload_file "$autoload_file" "$fleet_root"
  fi
done

# 3. Process fleet-nested *.dotfiles (e.g., ~/f/f.dotfiles, ~/a/a.dotfiles)
#    Walk fleet roots (dirs with .fleet.yml) and find *.dotfiles vessels inside
for fleet_manifest in "$HOME"/*/.fleet.yml "$HOME"/*/*/.fleet.yml; do
  [ -f "$fleet_manifest" ] || continue
  fleet_root="${fleet_manifest%/.fleet.yml}"

  for dotfiles_dir in "$fleet_root"/*.dotfiles \
                      "$fleet_root"/*/*.dotfiles \
                      "$fleet_root"/*/*/*.dotfiles; do
    [ -d "$dotfiles_dir" ] || continue
    autoload_file="$dotfiles_dir/tmuxp/autoload"
    if [ -f "$autoload_file" ]; then
      process_autoload_file "$autoload_file" "$fleet_root"
    fi
  done
done
