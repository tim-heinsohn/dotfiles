#!/bin/bash
#
# i3-startup: Login-time priming for the i3 session
#
# Usage: i3-startup
#
# Description:
# Runs once per i3 session to prime the gpg-agent cache so that any
# manually-launched tmuxp session ($mod+M -> rofi-tmuxp) or terminal
# afterwards finds gopass-backed secrets already unlocked.
#
# This script used to also autostart browsers and tmuxp profiles. That
# turned out to be the root cause of the boot-time pinentry-rofi storm
# AND of the "Nicht genügend Hauptspeicher verfügbar" decrypt failures:
# tmuxp fanned out ~16 zsh shells in parallel, each running direnv on
# project .envrc files with up to 30 `gopass show` calls, hammering
# gpg-agent's small secure-memory pool. Even with a fully warm cache
# the agent could not service that load and rejected many decrypts.
#
# Autostart of browsers and tmuxp has therefore been removed. Launch
# them on demand:
#   browsers : $mod+b (Firefox), or via dex/desktop entry
#   sessions : $mod+M (rofi-tmuxp) picks a single profile to load
#
# The single gpg-prewarm pass remains so that the very first manual
# launch is silent and fast.
#
# Dependencies:
# - ~/dotfiles/bin/gpg-prewarm
# - notify-send (libnotify) for the failure toast (optional)

set -euo pipefail

_notify() {
  command -v notify-send >/dev/null 2>&1 || return 0
  notify-send -u "${1:-normal}" -t "${2:-10000}" "$3" "${4:-}" 2>/dev/null || true
}

# Prime gpg-agent cache. Failure (ESC, missing key, agent broken) is
# non-fatal — there is no autostart fan-out to gate any more, so we just
# inform the user that gopass secrets will not be available silently and
# let them recover by running gpg-prewarm manually when ready.
gpg_prewarm="$HOME/dotfiles/bin/gpg-prewarm"
if [ -x "$gpg_prewarm" ]; then
  if ! "$gpg_prewarm"; then
    echo "i3-startup: gpg-prewarm did not unlock all keys." >&2
    echo "             Re-run with: gpg-prewarm" >&2
    _notify normal 8000 \
      "GPG prewarm skipped" \
      "Secrets backed by gopass will prompt on first use.
Re-run with: gpg-prewarm"
  fi
fi
