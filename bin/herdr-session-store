#!/bin/bash
#
# herdr-session-store: Save a running herdr session to a restore script
#
# Usage: herdr-session-store [OPTIONS] [SESSION_NAME]
#
# Description:
#   Captures the current workspaces and tabs of a running herdr session
#   and writes an idempotent restore script to:
#     ~/.config/herdr/store/<SESSION_NAME>
#
#   With -a|--all, stores every currently running session.
#   Without arguments and without -a, presents an fzf picker over running
#   sessions.
#
# Dependencies:
#   - herdr
#   - jq
#   - fzf (for interactive selection)

set -euo pipefail

# Extract session names from herdr's tabular output.
_herdr_session_names() {
  herdr session list 2>/dev/null | awk '{print $1}' | grep -v '^NAME$' || true
}

print_help() {
  cat <<'EOF'
herdr-session-store: Save a running herdr session to a restore script

Usage: herdr-session-store [OPTIONS] [SESSION_NAME]

Description:
  Captures the current workspaces and tabs of a running herdr session
  and writes an idempotent restore script to:
    ~/.config/herdr/store/<SESSION_NAME>

  Sessions are stored machine-local under ~/.config/herdr/store/
  (not versioned in dotfiles), since herdr sessions are considered
  fluid and private per machine.

Options:
  -a, --all        Store all currently running sessions
  -h, --help       Show this help message

Examples:
  herdr-session-store work       # Store session "work"
  herdr-session-store            # Pick a running session via fzf
  herdr-session-store -a         # Store all running sessions
EOF
}

ALL=false
SESSION_NAME=""

while [ $# -gt 0 ]; do
  case "$1" in
    -a|--all) ALL=true; shift ;;
    -h|--help) print_help; exit 0 ;;
    -*) echo "Unknown option: $1" >&2; exit 1 ;;
    *) SESSION_NAME="$1"; shift ;;
  esac
done

STORE_DIR="${HOME}/.config/herdr/store"
mkdir -p "$STORE_DIR"

store_session() {
  local name="$1"
  local outfile="$STORE_DIR/${name}"

  if ! herdr --session "$name" status server >/dev/null 2>&1; then
    echo "Session '$name' is not running, skipping." >&2
    return 1
  fi

  {
    echo "#!/bin/bash"
    echo "set -euo pipefail"
    echo "# Auto-generated by herdr-session-store"
    echo "# Session: ${name}"
    echo "# Date: $(date -Iseconds)"
    echo ""
    echo "# Idempotent helpers"
    echo "_ws_exists() {"
    echo '  local label="$1"'
    echo '  herdr --session "${HERDR_SESSION}" workspace list 2>/dev/null | jq -e ".result.workspaces[] | select(.label == \"\$label\")" >/dev/null 2>&1'
    echo "}"
    echo ""
    echo "_tab_exists() {"
    echo '  local ws_id="$1" label="$2"'
    echo '  herdr --session "${HERDR_SESSION}" tab list --workspace "\$ws_id" 2>/dev/null | jq -e ".result.tabs[] | select(.label == \"\$label\")" >/dev/null 2>&1'
    echo "}"
    echo ""
    echo "_get_ws_id() {"
    echo '  local label="$1"'
    echo '  herdr --session "${HERDR_SESSION}" workspace list 2>/dev/null | jq -r ".result.workspaces[] | select(.label == \"\$label\") | .workspace_id"'
    echo "}"
    echo ""

    local workspaces_json
    workspaces_json=$(herdr --session "$name" workspace list 2>/dev/null || true)

    if [ -z "$workspaces_json" ] || [ "$workspaces_json" = "null" ]; then
      echo "# Warning: no workspace data returned for session '$name'" >&2
      workspaces_json='{}'
    fi

    local found_workspaces=0

    while IFS=$'\t' read -r ws_id ws_label; do
      [ -n "$ws_label" ] || continue
      found_workspaces=1

      printf '\n# Workspace: %s\n' "$ws_label"
      printf 'if ! _ws_exists %q; then\n' "$ws_label"
      printf '  herdr --session "${HERDR_SESSION}" workspace create --label %q --no-focus\n' "$ws_label"
      printf 'fi\n'
      printf 'WS_ID=$(_get_ws_id %q)\n' "$ws_label"

      local tabs_json
      tabs_json=$(herdr --session "$name" tab list --workspace "$ws_id" 2>/dev/null || true)

      if [ -z "$tabs_json" ] || [ "$tabs_json" = "null" ]; then
        tabs_json='{}'
      fi

      while IFS=$'\t' read -r tab_label; do
        [ -n "$tab_label" ] || continue

        printf '\n# Tab: %s\n' "$tab_label"
        printf 'if [ -n "\$WS_ID" ] && [ "\$WS_ID" != "null" ] && ! _tab_exists "\$WS_ID" %q; then\n' "$tab_label"
        printf '  herdr --session "${HERDR_SESSION}" tab create --workspace "\$WS_ID" --label %q --no-focus\n' "$tab_label"
        printf 'fi\n'
      done < <(echo "$tabs_json" | jq -r '.result.tabs[]? | "\(.label)"' 2>/dev/null || true)

    done < <(echo "$workspaces_json" | jq -r '.result.workspaces[]? | "\(.workspace_id)\t\(.label)"' 2>/dev/null || true)

    if [ "$found_workspaces" -eq 0 ]; then
      echo ""
      echo "# Warning: no workspaces found. Raw JSON was:"
      echo "# $workspaces_json" | sed 's/^/# /'
    fi

  } > "$outfile"

  chmod +x "$outfile"
  echo "Session '$name' saved to $outfile"
}

if [ "$ALL" = true ]; then
  mapfile -t running < <(_herdr_session_names)
  if [ ${#running[@]} -eq 0 ]; then
    echo "No running herdr sessions found." >&2
    exit 1
  fi
  for s in "${running[@]}"; do
    [ -n "$s" ] || continue
    store_session "$s"
  done
elif [ -n "$SESSION_NAME" ]; then
  store_session "$SESSION_NAME"
else
  if ! command -v fzf >/dev/null 2>&1; then
    echo "fzf is required for interactive selection. Install it or pass a session name." >&2
    exit 1
  fi
  selected=$(_herdr_session_names | fzf --prompt="herdr session to store> " || true)
  if [ -z "$selected" ]; then
    exit 0
  fi
  store_session "$selected"
fi
