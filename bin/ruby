#!/usr/bin/env bash
set -euo pipefail

# Ruby wrapper that honors project and global versions managed by mise.
if command -v mise >/dev/null 2>&1; then
    exec mise exec -- ruby "$@"
fi

# Keep existing RVM installations usable when mise is unavailable.
if [ -s "$HOME/.rvm/scripts/rvm" ]; then
    # shellcheck source=/dev/null
    source "$HOME/.rvm/scripts/rvm"
    exec ruby "$@"
fi

if [ -x /usr/bin/ruby ]; then
    exec /usr/bin/ruby "$@"
fi

echo "Error: Ruby is not available through mise, RVM, or /usr/bin/ruby." >&2
exit 1

# vi: ft=bash
