#!/bin/bash
#
# wellbeing-lock: Remind the user about digital wellbeing boundaries.
#
# Usage: wellbeing-lock
#
# Description:
# Checks for an active snooze. If none, sends a late-night warning via
# notify-send. The systemd timer controls how often the warning is shown.
#
# Dependencies:
# - libnotify

set -euo pipefail

SNOOZE_FILE="/tmp/wellbeing_snooze_until"

check_snooze() {
    local now
    now=$(date +%s)
    if [[ -f "$SNOOZE_FILE" ]]; then
        local snooze_until
        snooze_until=$(cat "$SNOOZE_FILE" 2>/dev/null || echo 0)
        if [[ "$now" -lt "$snooze_until" ]]; then
            return 0
        else
            rm -f "$SNOOZE_FILE" 2>/dev/null || true
            return 1
        fi
    fi
    return 1
}

if check_snooze; then
    now=$(date +%s)
    snooze_until=$(cat "$SNOOZE_FILE")
    remaining=$(( (snooze_until - now) / 60 ))
    echo "Snooze active for another $remaining minutes. Warning suppressed."
    exit 0
fi

CURRENT_TIME=$(date +"%H:%M")
notify-send -u critical -t 60000 \
    "DIGITAL WELLBEING" \
    "It is $CURRENT_TIME. Why are you still here? Go to sleep." \
    2>/dev/null || true
