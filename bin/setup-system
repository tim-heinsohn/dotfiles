#!/bin/bash
#
# setup-system: Provision an Arch system with dotfiles
#
# Usage: setup-system [PACKAGE|all] [--extended]
#
# Packages:
#   base       System update, dotfiles, core packages, services, user groups
#   languages  Node.js, npm packages, uv tools, Ruby/mise
#   devtools   Git CLIs, overcommit, terraform-ls, Bun
#   ai         Aider, Whisper, Tree-sitter
#   desktop    Wallpapers, scanner
#   extras     Disk health monitoring, Java 17
#   all        Everything (default)
#
# Options:
#   --extended Update opt-in package bundles, including time-consuming packages
#
# Description:
#   Installs and configures the system in modular packages.
#   Run with sudo access; the script keeps sudo alive automatically.
#   Requires Bash (the default /bin/sh implementation on Arch Linux).

if [ -z "${BASH_VERSION:-}" ]; then
    echo "Error: setup-system requires Bash. Run it with 'bash setup-system'." >&2
    exit 1
fi

set -euo pipefail

DOTFILES_REPO=${DOTFILES_REPO:-https://github.com/tim-heinsohn/dotfiles.git}
DOTFILES_DIR=${DOTFILES_DIR:-$HOME/p/dotfiles}
export DOTFILES_DIR
SETUP_MIN_FREE_GIB=${SETUP_MIN_FREE_GIB:-15}
SETUP_MIN_FREE_INODES=${SETUP_MIN_FREE_INODES:-100000}
SETUP_MIN_TMP_GIB=${SETUP_MIN_TMP_GIB:-2}

# ── Helpers ──────────────────────────────────────────────────────────

headline() {
    echo ""
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    echo "  $1"
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
}

run_if_exists() {
    local script="$1"
    shift || true
    if [ -x "$script" ]; then
        "$script" "$@"
    else
        echo "⚠  Skipping missing script: $script" >&2
    fi
}

declare -A checked_storage_filesystems=()

check_storage_path() {
    local path="$1"
    local required_gib="$2"
    local filesystem mountpoint free_kib free_gib required_kib
    local free_inodes fs_type inode_status

    while [ ! -e "$path" ] && [ "$path" != "/" ]; do
        path=$(dirname "$path")
    done

    filesystem=$(df -Pk "$path" | awk 'END { print $1 }')
    if [ -n "${checked_storage_filesystems[$filesystem]:-}" ]; then
        return 0
    fi
    checked_storage_filesystems[$filesystem]=1

    mountpoint=$(df -Pk "$path" | awk 'END { print $6 }')
    free_kib=$(df -Pk "$path" | awk 'END { print $4 }')
    free_inodes=$(df -Pi "$path" | awk 'END { print $4 }')
    fs_type=$(stat -f -c '%T' "$path" 2>/dev/null || true)
    required_kib=$((required_gib * 1024 * 1024))
    free_gib=$((free_kib / 1024 / 1024))

    inode_status="${free_inodes} inodes"
    if ! [[ "$free_inodes" =~ ^[0-9]+$ ]] \
        || { [ "$free_inodes" = "0" ] && [ "$fs_type" = "btrfs" ]; }; then
        inode_status="dynamic inode allocation"
        free_inodes=""
    fi

    echo "Storage preflight: ${free_gib} GiB and ${inode_status} available on ${mountpoint}."

    if (( free_kib < required_kib )); then
        echo "Error: ${mountpoint} requires ${required_gib} GiB free; ${free_gib} GiB is available." >&2
        return 1
    fi
    if [ -n "$free_inodes" ] && (( free_inodes < SETUP_MIN_FREE_INODES )); then
        echo "Error: ${mountpoint} requires ${SETUP_MIN_FREE_INODES} free inodes; ${free_inodes} are available." >&2
        return 1
    fi
}

check_storage() {
    local value failed=0

    for value in "$SETUP_MIN_FREE_GIB" "$SETUP_MIN_FREE_INODES" "$SETUP_MIN_TMP_GIB"; do
        if ! [[ "$value" =~ ^[0-9]+$ ]]; then
            echo "Error: storage thresholds must be non-negative integers." >&2
            exit 1
        fi
    done

    check_storage_path "/" "$SETUP_MIN_FREE_GIB" || failed=1
    check_storage_path "$HOME" "$SETUP_MIN_FREE_GIB" || failed=1
    check_storage_path "$DOTFILES_DIR" "$SETUP_MIN_FREE_GIB" || failed=1
    check_storage_path "${TMPDIR:-/tmp}" "$SETUP_MIN_TMP_GIB" || failed=1

    if (( failed )); then
        echo "Error: insufficient storage for system setup." >&2
        echo "Free storage (for example with ${DOTFILES_DIR}/bin/clear-cache) and retry." >&2
        exit 1
    fi
}

keep_sudo_alive() {
    if ! command -v sudo >/dev/null 2>&1; then
        echo "Error: sudo is required. Install and configure it for this user before running setup-system." >&2
        exit 1
    fi

    if ! sudo -v 2>/dev/null; then
        echo "Error: sudo authentication required." >&2
        echo "Run 'sudo -v' before this script, or run interactively first." >&2
        exit 1
    fi

    # Refresh sudo timestamp every 60 s so it never expires during long runs
    (
        while true; do
            sleep 60
            sudo -n true 2>/dev/null || true
        done
    ) &
    SUDO_KEEPALIVE_PID=$!
    trap 'kill "$SUDO_KEEPALIVE_PID" 2>/dev/null || true' EXIT
}

ensure_dotfiles_repo() {
    if [ -d "${DOTFILES_DIR}/.git" ]; then
        if ! git -C "${DOTFILES_DIR}" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
            echo "Error: ${DOTFILES_DIR} exists but is not a valid Git repository." >&2
            return 1
        fi

        local current_branch
        current_branch=$(git -C "${DOTFILES_DIR}" rev-parse --abbrev-ref HEAD 2>/dev/null || echo "unknown")
        if git -C "${DOTFILES_DIR}" rev-parse --abbrev-ref --symbolic-full-name "@{u}" >/dev/null 2>&1; then
            headline "Updating dotfiles repository (${current_branch})"
            git -C "${DOTFILES_DIR}" pull --ff-only
        else
            echo "Dotfiles repository already present at ${DOTFILES_DIR}." >&2
            echo "Current branch '${current_branch}' has no upstream; skipping git pull." >&2
        fi
    elif [ -e "${DOTFILES_DIR}" ]; then
        echo "Error: ${DOTFILES_DIR} exists but is not a Git repository." >&2
        return 1
    else
        headline "Cloning dotfiles repository"
        git clone "${DOTFILES_REPO}" "${DOTFILES_DIR}"
    fi
}

ensure_gem() {
    if ! command -v gem >/dev/null 2>&1; then
        if [ -s "$HOME/.rvm/scripts/rvm" ]; then
            # shellcheck source=/dev/null
            source "$HOME/.rvm/scripts/rvm"
        fi
    fi
}

ensure_yay() {
    if command -v yay >/dev/null 2>&1 && yay --version >/dev/null 2>&1; then
        echo "yay is already available."
        return 0
    fi

    echo "yay is not available; installing it before installing package bundles."
    run_if_exists "${DOTFILES_DIR}/bin/setup-yay"

    if ! command -v yay >/dev/null 2>&1 || ! yay --version >/dev/null 2>&1; then
        echo "Error: yay is required to install this repository's AUR packages." >&2
        return 1
    fi
}

ensure_bombadil() {
    if command -v bombadil >/dev/null 2>&1; then
        return 0
    fi

    echo "Installing toml-bombadil before linking dotfiles."
    sudo pacman -S --needed --noconfirm toml-bombadil
}

set_default_shell() {
    local target_user current_shell
    local zsh_path="/usr/bin/zsh"

    sudo pacman -S --needed --noconfirm zsh

    if [ ! -x "$zsh_path" ] || ! grep -Fxq "$zsh_path" /etc/shells; then
        echo "Error: $zsh_path is not an approved login shell." >&2
        return 1
    fi

    target_user=$(id -un)
    current_shell=$(getent passwd "$target_user" | cut -d: -f7)
    if [ "$current_shell" = "$zsh_path" ]; then
        echo "zsh is already the default shell for $target_user."
        return 0
    fi

    sudo chsh -s "$zsh_path" "$target_user"
    echo "zsh is now the default shell for $target_user; it takes effect at the next login."
}

# ── Packages ─────────────────────────────────────────────────────────

safe_pacman_update() {
    # Pre-populate the keyring so PGP key-import prompts are minimised.
    # pacman still prints the prompt text, but --noconfirm auto-answers
    # the default ("yes" for [J/n]), so the import succeeds.
    if command -v pacman-key >/dev/null 2>&1; then
        sudo pacman-key --init 2>/dev/null || true
        sudo pacman-key --populate archlinux 2>/dev/null || true
    fi

    # Try a fully non-interactive update first.
    if sudo pacman -Suy --needed --noconfirm; then
        return 0
    fi

    echo "⚠  Non-interactive update failed. Checking for known transition conflicts…" >&2

    # Known transitional / renamed packages that block the transaction
    local conflicts=()
    pacman -Q geocode-glib-common >/dev/null 2>&1 && conflicts+=(geocode-glib-common)
    pacman -Q geocode-glib-2     >/dev/null 2>&1 && conflicts+=(geocode-glib-2)
    pacman -Q sheldon-docs       >/dev/null 2>&1 && conflicts+=(sheldon-docs)

    if [ ${#conflicts[@]} -gt 0 ]; then
        echo "Removing conflicting packages: ${conflicts[*]}" >&2
        sudo pacman -Rdd --noconfirm "${conflicts[@]}" 2>/dev/null || true
    fi

    # Retry once after cleanup
    sudo pacman -Suy --needed --noconfirm
}

pkg_base() {
    headline "System Update"
    safe_pacman_update
    gpgconf --kill all 2>/dev/null || true

    headline "Git"
    sudo pacman -S --needed --noconfirm git

    headline "Dotfiles Repository"
    ensure_dotfiles_repo

    headline "AUR Helper (yay)"
    ensure_yay

    headline "Dotfile Manager (Bombadil)"
    ensure_bombadil

    headline "Linking dotfiles (Bombadil)"
    mkdir -p "$HOME/.config"
    ln -sf "${DOTFILES_DIR}/bombadil.toml" "$HOME/.config/bombadil.toml"
    cd "${DOTFILES_DIR}"
    bombadil link

    hash -r 2>/dev/null || true
    if command -v sheldeon >/dev/null 2>&1; then
        sheldeon lock
    else
        echo "⚠  sheldeon not found, skipping lock" >&2
    fi

    headline "Core Packages"
    run_if_exists "${DOTFILES_DIR}/bin/packages-install"

    headline "Default Shell (zsh)"
    set_default_shell

    headline "System Configuration"
    run_if_exists "${DOTFILES_DIR}/docker/docker-group-setup"

    headline "User Groups"
    sudo usermod -aG wheel "$USER"
    sudo usermod -aG video "$USER"
    sudo usermod -aG audio "$USER"

    headline "System Services"
    sudo systemctl enable --now acpid
    sudo systemctl enable --now bluetooth
    sudo systemctl enable --now docker
    sudo systemctl enable --now tailscaled

    headline "Cache Cleanup"
    sudo paccache -rk1
}

pkg_languages() {
    headline "Node.js (NVM)"
    if command -v yay >/dev/null 2>&1; then
        # nvm-git conflicts with the stable nvm package
        if pacman -Q nvm-git >/dev/null 2>&1; then
            echo "Removing conflicting nvm-git before installing nvm..."
            sudo pacman -Rdd --noconfirm nvm-git
        fi
        yay -S --needed --noconfirm nvm
    else
        echo "⚠  yay not found, skipping nvm install" >&2
    fi

    # shellcheck source=/dev/null
    [ -s "/usr/share/nvm/init-nvm.sh" ] && source "/usr/share/nvm/init-nvm.sh"
    if command -v nvm >/dev/null 2>&1; then
        nvm install 24.4.0
        nvm alias default 24.4.0
    else
        echo "⚠  nvm not available, skipping Node.js setup" >&2
    fi

    headline "Global npm Packages"
    run_if_exists "${DOTFILES_DIR}/bin/npm-packages" auto

    headline "UV Python Tools"
    run_if_exists "${DOTFILES_DIR}/bin/uv-packages" auto

    headline "mise-en-place (polyglot runtime manager)"
    run_if_exists "${DOTFILES_DIR}/bin/setup-mise"

    # Ensure the freshly installed mise binary and its shims are on PATH
    # for the rest of this script (activation via .zshrc only applies to
    # interactive shells).
    if [ -x "$HOME/.local/bin/mise" ]; then
        export PATH="$HOME/.local/bin:$HOME/.local/share/mise/shims:$PATH"
    fi

    headline "Ruby (via mise)"
    if command -v mise >/dev/null 2>&1; then
        mise use -g ruby@3.3.6
    else
        echo "⚠  mise not available, skipping Ruby setup" >&2
    fi

    # Legacy RVM setup: kept for opt-in reinstall. Not run by default.
    # To reinstall RVM manually: ${DOTFILES_DIR}/ruby/rvm-setup
}

pkg_devtools() {
    headline "Git Service CLIs"
    run_if_exists "${DOTFILES_DIR}/bin/git-cli-setup"

    headline "Overcommit"
    ensure_gem
    if command -v gem >/dev/null 2>&1; then
        if gem list -i '^overcommit$' >/dev/null 2>&1; then
            echo "✓ Overcommit already installed: $(overcommit --version 2>/dev/null || echo 'version unavailable')"
        else
            gem install overcommit --no-document
            echo "✓ Overcommit installed: $(overcommit --version 2>/dev/null || echo 'version unavailable')"
        fi
    else
        echo "⚠  gem not available, skipping overcommit install" >&2
    fi

    headline "Terraform Language Server"
    run_if_exists "${DOTFILES_DIR}/terraform-ls/install"

    headline "Bun"
    run_if_exists "${DOTFILES_DIR}/bin/setup-bun"
}

pkg_ai() {
    headline "Aider"
    run_if_exists "${DOTFILES_DIR}/aider/install"

    headline "Whisper"
    run_if_exists "${DOTFILES_DIR}/whisper/setup"

    headline "Tree-sitter Parsers"
    if command -v nvim >/dev/null 2>&1; then
        nvim --headless "+TSUpdateSync" "+qa" || true
    else
        echo "ℹ  nvim not found, skipping tree-sitter update" >&2
    fi
}

pkg_desktop() {
    headline "Wallpapers"
    run_if_exists "${DOTFILES_DIR}/bin/setup-wallpapers"

    headline "Scanner"
    if lsusb | grep -q "04b8:0142" 2>/dev/null; then
        run_if_exists "${DOTFILES_DIR}/bin/scanner/setup-epson-v330"
    else
        echo "ℹ  Epson V330 not detected, skipping scanner setup"
    fi
}

pkg_extras() {
    headline "Disk Health Monitoring"
    run_if_exists "${DOTFILES_DIR}/bin/disk-health-setup" --install

    headline "Java Version"
    sudo pacman -S --needed --noconfirm jdk17-openjdk
    sudo archlinux-java set java-17-openjdk
}

pkg_extended() {
    headline "Extended Package Bundles"
    run_if_exists "${DOTFILES_DIR}/bin/packages-install" --extended
}

# ── Main ─────────────────────────────────────────────────────────────

print_help() {
    cat <<'EOF'
Usage: setup-system [PACKAGE|all] [--extended]

Provisions an Arch system with this dotfiles repo in modular packages.

Packages:
  base       System update, dotfiles, core packages, services, user groups
  languages  Node.js, npm packages, uv tools, Ruby/mise
  devtools   Git CLIs, overcommit, terraform-ls, Bun
  ai         Aider, Whisper, Tree-sitter
  desktop    Wallpapers, scanner
  extras     Disk health monitoring, Java 17
  all        Everything (default)

Options:
  --extended Update opt-in package bundles, including time-consuming packages

Environment:
  DOTFILES_REPO   Source Git repository
                  (default: https://github.com/tim-heinsohn/dotfiles.git)
  DOTFILES_DIR    Destination directory (default: ~/p/dotfiles)
  SETUP_MIN_FREE_GIB
                  Minimum free storage required at startup (default: 15)
  SETUP_MIN_FREE_INODES
                  Minimum free inodes required at startup (default: 100000)
  SETUP_MIN_TMP_GIB
                  Minimum free temporary storage required (default: 2)

Examples:
  setup-system base
  setup-system devtools
  setup-system all
  setup-system --extended
EOF
}

main() {
    local target="all"
    local update_extended=0
    local target_set=0
    local argument

    for argument in "$@"; do
        case "$argument" in
            -h|--help)
                print_help
                exit 0
                ;;
            --extended)
                update_extended=1
                ;;
            base|languages|devtools|ai|desktop|extras|all)
                if (( target_set )); then
                    echo "Only one package target may be specified." >&2
                    print_help >&2
                    exit 1
                fi
                target="$argument"
                target_set=1
                ;;
            *)
                echo "Unknown package or option: $argument" >&2
                print_help >&2
                exit 1
                ;;
        esac
    done

    case "$target" in
        base|languages|devtools|ai|desktop|extras|all)
            ;;
        *)
            echo "Unknown package: $target" >&2
            print_help >&2
            exit 1
            ;;
    esac

    check_storage
    keep_sudo_alive

    if [ "$target" = "all" ]; then
        pkg_base
        pkg_languages
        pkg_devtools
        pkg_ai
        pkg_desktop
        pkg_extras
    else
        "pkg_$target"
    fi

    if (( update_extended )); then
        pkg_extended
    else
        echo "ℹ  Extended bundles are not being updated; rerun with --extended to update them."
    fi

    headline "Done"
    echo "Setup complete."
}

main "$@"
