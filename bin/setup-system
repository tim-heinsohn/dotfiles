#!/bin/bash
#
# setup-system: Provision an Arch system with dotfiles
#
# Usage: setup-system [PACKAGE|all|-h|--help]
#
# Packages:
#   base       System update, dotfiles, core packages, services, user groups
#   languages  Node.js, npm packages, uv tools, Ruby/RVM
#   devtools   Git CLIs, overcommit, terraform-ls, Bun
#   ai         Aider, Whisper, Tree-sitter
#   desktop    Wallpapers, scanner
#   extras     Open Design, disk health monitoring, Java 17
#   all        Everything (default)
#
# Description:
#   Installs and configures the system in modular packages.
#   Run with sudo access; the script keeps sudo alive automatically.

set -euo pipefail

DOTFILES_REPO=${DOTFILES_REPO:-https://github.com/tim-heinsohn/dotfiles.git}
DOTFILES_DIR=${DOTFILES_DIR:-$HOME/dotfiles}

# ── Helpers ──────────────────────────────────────────────────────────

headline() {
    echo ""
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    echo "  $1"
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
}

run_if_exists() {
    local script="$1"
    shift || true
    if [ -x "$script" ]; then
        "$script" "$@"
    else
        echo "⚠  Skipping missing script: $script" >&2
    fi
}

keep_sudo_alive() {
    if ! sudo -v 2>/dev/null; then
        echo "Error: sudo authentication required." >&2
        echo "Run 'sudo -v' before this script, or run interactively first." >&2
        exit 1
    fi

    # Refresh sudo timestamp every 60 s so it never expires during long runs
    (
        while true; do
            sleep 60
            sudo -n true 2>/dev/null || true
        done
    ) &
    SUDO_KEEPALIVE_PID=$!
    trap 'kill "$SUDO_KEEPALIVE_PID" 2>/dev/null || true' EXIT
}

ensure_dotfiles_repo() {
    if [ -d "${DOTFILES_DIR}/.git" ]; then
        if ! git -C "${DOTFILES_DIR}" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
            echo "Error: ${DOTFILES_DIR} exists but is not a valid Git repository." >&2
            return 1
        fi

        local current_branch
        current_branch=$(git -C "${DOTFILES_DIR}" rev-parse --abbrev-ref HEAD 2>/dev/null || echo "unknown")
        if git -C "${DOTFILES_DIR}" rev-parse --abbrev-ref --symbolic-full-name "@{u}" >/dev/null 2>&1; then
            headline "Updating dotfiles repository (${current_branch})"
            git -C "${DOTFILES_DIR}" pull --ff-only
        else
            echo "Dotfiles repository already present at ${DOTFILES_DIR}." >&2
            echo "Current branch '${current_branch}' has no upstream; skipping git pull." >&2
        fi
    elif [ -e "${DOTFILES_DIR}" ]; then
        echo "Error: ${DOTFILES_DIR} exists but is not a Git repository." >&2
        return 1
    else
        headline "Cloning dotfiles repository"
        git clone "${DOTFILES_REPO}" "${DOTFILES_DIR}"
    fi
}

ensure_gem() {
    if ! command -v gem >/dev/null 2>&1; then
        if [ -s "$HOME/.rvm/scripts/rvm" ]; then
            # shellcheck source=/dev/null
            source "$HOME/.rvm/scripts/rvm"
        fi
    fi
}

# ── Packages ─────────────────────────────────────────────────────────

pkg_base() {
    headline "System Update"
    sudo pacman -Suy --needed --noconfirm git
    gpgconf --kill all 2>/dev/null || true

    headline "Dotfiles Repository"
    ensure_dotfiles_repo

    headline "Linking dotfiles (Bombadil)"
    mkdir -p "$HOME/.config"
    ln -sf "${DOTFILES_DIR}/bombadil.toml" "$HOME/.config/bombadil.toml"
    cd "${DOTFILES_DIR}"
    bombadil link

    hash -r 2>/dev/null || true
    if command -v sheldeon >/dev/null 2>&1; then
        sheldeon lock
    else
        echo "⚠  sheldeon not found, skipping lock" >&2
    fi

    headline "AUR Helper (yay)"
    run_if_exists "${DOTFILES_DIR}/bin/setup-yay"

    headline "Core Packages"
    run_if_exists "${DOTFILES_DIR}/bin/packages-install"

    headline "System Configuration"
    run_if_exists "${DOTFILES_DIR}/docker/docker-group-setup"

    headline "User Groups"
    sudo usermod -aG wheel "$USER"
    sudo usermod -aG video "$USER"
    sudo usermod -aG audio "$USER"

    headline "System Services"
    sudo systemctl enable --now acpid
    sudo systemctl enable --now bluetooth
    sudo systemctl enable --now docker
    sudo systemctl enable --now tailscaled

    headline "Cache Cleanup"
    sudo paccache -rk1
}

pkg_languages() {
    headline "Node.js (NVM)"
    if command -v yay >/dev/null 2>&1; then
        yay -S --needed --noconfirm nvm
    else
        echo "⚠  yay not found, skipping nvm install" >&2
    fi

    # shellcheck source=/dev/null
    [ -s "/usr/share/nvm/init-nvm.sh" ] && source "/usr/share/nvm/init-nvm.sh"
    if command -v nvm >/dev/null 2>&1; then
        nvm install 24.4.0
        nvm alias default 24.4.0
    else
        echo "⚠  nvm not available, skipping Node.js setup" >&2
    fi

    headline "Global npm Packages"
    run_if_exists "${DOTFILES_DIR}/bin/npm-packages" auto

    headline "UV Python Tools"
    run_if_exists "${DOTFILES_DIR}/bin/uv-packages" auto

    headline "Ruby (RVM)"
    run_if_exists "${DOTFILES_DIR}/ruby/rvm-setup"
}

pkg_devtools() {
    headline "Git Service CLIs"
    run_if_exists "${DOTFILES_DIR}/bin/git-cli-setup"

    headline "Overcommit"
    ensure_gem
    if command -v gem >/dev/null 2>&1; then
        gem list overcommit -i >/dev/null 2>&1 || gem install overcommit
    else
        echo "⚠  gem not available, skipping overcommit install" >&2
    fi

    headline "Terraform Language Server"
    run_if_exists "${DOTFILES_DIR}/terraform-ls/install"

    headline "Bun"
    run_if_exists "${DOTFILES_DIR}/bin/setup-bun"
}

pkg_ai() {
    headline "Aider"
    run_if_exists "${DOTFILES_DIR}/aider/install"

    headline "Whisper"
    run_if_exists "${DOTFILES_DIR}/whisper/setup"

    headline "Tree-sitter Parsers"
    if command -v nvim >/dev/null 2>&1; then
        nvim --headless "+TSUpdateSync" "+qa" || true
    else
        echo "ℹ  nvim not found, skipping tree-sitter update" >&2
    fi
}

pkg_desktop() {
    headline "Wallpapers"
    run_if_exists "${DOTFILES_DIR}/bin/setup-wallpapers"

    headline "Scanner"
    if lsusb | grep -q "04b8:0142" 2>/dev/null; then
        run_if_exists "${DOTFILES_DIR}/bin/scanner/setup-epson-v330"
    else
        echo "ℹ  Epson V330 not detected, skipping scanner setup"
    fi
}

pkg_extras() {
    headline "Open Design"
    run_if_exists "${DOTFILES_DIR}/bin/setup-open-design"

    headline "Disk Health Monitoring"
    run_if_exists "${DOTFILES_DIR}/bin/disk-health-setup" --install

    headline "Java Version"
    sudo archlinux-java set java-17-openjdk
}

# ── Main ─────────────────────────────────────────────────────────────

print_help() {
    cat <<'EOF'
Usage: setup-system [PACKAGE|all|-h|--help]

Provisions an Arch system with this dotfiles repo in modular packages.

Packages:
  base       System update, dotfiles, core packages, services, user groups
  languages  Node.js, npm packages, uv tools, Ruby/RVM
  devtools   Git CLIs, overcommit, terraform-ls, Bun
  ai         Aider, Whisper, Tree-sitter
  desktop    Wallpapers, scanner
  extras     Open Design, disk health monitoring, Java 17
  all        Everything (default)

Environment:
  DOTFILES_REPO   Source Git repository
                  (default: https://github.com/tim-heinsohn/dotfiles.git)
  DOTFILES_DIR    Destination directory (default: ~/dotfiles)

Examples:
  setup-system base
  setup-system devtools
  setup-system all
EOF
}

main() {
    local target="${1:-all}"

    case "$target" in
        -h|--help)
            print_help
            exit 0
            ;;
        base|languages|devtools|ai|desktop|extras|all)
            ;;
        *)
            echo "Unknown package: $target" >&2
            print_help >&2
            exit 1
            ;;
    esac

    keep_sudo_alive

    if [ "$target" = "all" ]; then
        pkg_base
        pkg_languages
        pkg_devtools
        pkg_ai
        pkg_desktop
        pkg_extras
    else
        "pkg_$target"
    fi

    headline "Done"
    echo "Setup complete."
}

main "$@"
